<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to the DevBox on the LAN: the update server (relay, :8000) and the live-log receiver (:8792).
     Updates are signature-verified and log batches HMAC-signed, so TLS adds nothing here. Everything else: HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.178.11</domain>
    </domain-config>
</network-security-config>
